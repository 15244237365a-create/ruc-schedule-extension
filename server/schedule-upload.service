[Unit]
Description=RUC Schedule ICS upload service
After=network.target

[Service]
Type=simple
# 建议用非 root 专用用户运行；User=你的运行用户
User=ubuntu
Group=ubuntu
# 按实际脚本位置修改；OUT_DIR 在脚本顶部配置
ExecStart=/usr/bin/python3 /opt/schedule_upload/schedule_upload.py
Restart=always
RestartSec=3
# 沙箱：整个文件系统只读，仅 OUT_DIR 可写
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/schedule-ics

[Install]
WantedBy=multi-user.target
